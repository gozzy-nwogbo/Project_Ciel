# ============================================
# Second Brain — .gitignore
# Skeleton tracked, personal content ignored.
# ============================================

# --- Secrets & credentials ---
.env
.env.*
*.env
.mcp.json

# --- Personal content directories ---
00-inbox/
02-knowledge/
03-reflections/
04-reflections/
06-daily/
07-portfolio/
09-system/

# --- 01-projects: gitignore all except whitelisted skeletons ---
01-projects/*
!01-projects/open-brain/
01-projects/open-brain/*
!01-projects/open-brain/architecture/
!01-projects/open-brain/mcp-server/
01-projects/.claude/

# --- 01-projects/linkedin: whitelist code + docs; ignore runtime data ---
!01-projects/linkedin/
01-projects/linkedin/*
!01-projects/linkedin/src/
!01-projects/linkedin/tests/
!01-projects/linkedin/docs/
!01-projects/linkedin/bin/
!01-projects/linkedin/scripts/
!01-projects/linkedin/CLAUDE.md
!01-projects/linkedin/brand-spec.md
!01-projects/linkedin/sources.yml
!01-projects/linkedin/pyproject.toml
!01-projects/linkedin/requirements.txt
!01-projects/linkedin/requirements-dev.txt
01-projects/linkedin/backlog/
01-projects/linkedin/state/
01-projects/linkedin/logs/
01-projects/linkedin/.cache/

# --- 05-daily: keep TEMPLATE.md tracked ---
05-daily/*
!05-daily/TEMPLATE.md

# --- .claude operational state (not skeleton) ---
.claude/logs/*
.claude/projects/
.claude/reminders/
.claude/state/
.claude/user.md
.claude/settings.json
.claude/settings.local.json

# --- Supabase CLI temp ---
supabase/

# --- Brainstorming companion runtime ---
.superpowers/

# --- Editor / OS ---
.obsidian/
*.canvas
.DS_Store
Thumbs.db

# --- Build artifacts ---
__pycache__/
*.pyc
.pytest_cache/
node_modules/
*.db
*.sqlite
